#
# Unisoc WCN device (NEW )configuration
#
menu "Unisoc WCN Device Drivers"
config UNISOC_WCN_BSP
	tristate "UNISOC_WCN_BSP"
	help
	  This is support wcn chip for Unisoc.
	  if you want to use 23xx series wcn chip of Unisoc.
	  please say "y".

config UNISOC_WCN_BSP_USER_VARIANT
	bool "Build the WCN drivers as the production (user) variant"
	depends on UNISOC_WCN_BSP
	help
	  The vendor's Kbuild takes parts of this driver's behaviour from
	  Android's build variant:

	    drivers/unisoc_platform/sprdwcn/Makefile and platform/Makefile
	      ifeq ($(TARGET_BUILD_VARIANT),user)
	      ccflags-y += -DFLAG_WCN_USER

	  and Android's lunch target sets TARGET_BUILD_VARIANT, so a kernel
	  built by hand silently gets the "userdebug" behaviour.  What that
	  means in practice is the assert policy in platform/sysfs.c: after
	  any WCN asset the userdebug default dumps the chip's memory and
	  marks the SDIO card dead (sprd_gem-style "carddump flag set[1]"),
	  which condemns every later start_marlin() until the next reboot,
	  while the user variant resets the chip and carries on.  The
	  loopcheck ping alone is enough to trigger it: the chip gets 4 s to
	  answer and one missed round is treated as an assert.

	  It also selects the qogirl6 reset-pad priority write in
	  btwf_sys_poweron() (boot/wcn_integrate_boot.c).

	  Say Y on a device that has to keep its radios working.
config SC23XX
	bool "SC23XX chip Support"
	#depends on MMC
	default n
	help
	  This is support wcn chip for Unisoc.
	  if you want to use 23xx series wcn chip of Unisoc.
	  please say "y".

